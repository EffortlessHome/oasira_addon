{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/gemma4:12b-mlx",

  "default_agent": "build",

  "instructions": [
    "AGENTS.md"
  ],

  "agent": {
    "build": {
      "mode": "primary",
      "model": "ollama/gemma4:12b-mlx",
      "temperature": 0.2
    },

    "plan": {
      "mode": "primary",
      "model": "ollama/gemma4:12b-mlx",
      "temperature": 0.1
    },

    "review": {
      "description": "Reviews code for correctness and regressions",
      "mode": "subagent",
      "model": "ollama/gemma4:12b-mlx",
      "temperature": 0.1,
      "permission": {
        "edit": "deny"
      }
    },

    "debug": {
      "description": "Diagnoses and fixes concrete coding errors",
      "mode": "subagent",
      "model": "ollama/gemma4:12b-mlx",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  }
}